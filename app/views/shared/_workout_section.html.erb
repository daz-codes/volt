<%# Locals: section (Hash), distance_sport (Boolean, optional),
#           workout (Workout, optional), section_index (Integer, optional),
#           swappable (Boolean, optional), preview_token (String, optional) %>
<% swappable     = local_assigns.fetch(:swappable, false)
   workout       = local_assigns.fetch(:workout, nil)
   section_index = local_assigns.fetch(:section_index, nil)
   preview_token = local_assigns.fetch(:preview_token, nil) %>
<% sec_format = section["format"].to_s %>
<% sec_mins = if sec_format == "tabata"
     r = section["rounds"].to_i > 0 ? section["rounds"].to_i : 8
     ((20 + 10) * r / 60.0).ceil
   elsif section["duration_mins"].to_i > 0
     section["duration_mins"].to_i
   end %>

<%# Section distance (for distance-based sports) %>
<% if local_assigns[:distance_sport]
     _dist_m = section_distance_m(section)
     if _dist_m >= 1000
       sec_dist_val  = (_dist_m / 1000.0).round(1).to_s.delete_suffix(".0")
       sec_dist_unit = "km"
     elsif _dist_m > 0
       sec_dist_val  = _dist_m.to_s
       sec_dist_unit = "m"
     end
   end %>

<%# Build sequence string for ladder/mountain sections %>
<% ladder_seq_str = nil
   switchback_down_str = nil
   switchback_up_str = nil
   if %w[ladder mountain].include?(sec_format)
     if ladder_has_per_exercise_overrides?(section)
       # Per-exercise sequences render under each exercise — no shared header.
       ladder_seq_str = nil
     else
       step = [section["step"].to_f, 1.0].max
       ladder_metric_unit = { "reps" => "reps", "calories" => "cal", "kg" => "kg", "distance_m" => "m" }
       ladder_effective_metrics = Array(section["exercises"]).map { |e| e["metric"].presence || section["varies"].to_s }
       ladder_metrics_mixed = ladder_effective_metrics.uniq.size > 1
       varies_lbl = if ladder_metrics_mixed
         ""
       else
         ladder_metric_unit.fetch(section["varies"].to_s, section["varies"].to_s)
       end
       if sec_format == "ladder"
         sv = section["start"].to_f; ev = section["end"].to_f
         vals = []
         if sv <= ev
           v = sv; while v <= ev + 0.001; vals << v; v += step; end
         else
           v = sv; while v >= ev - 0.001; vals << v; v -= step; end
         end
       else
         sv = section["start"].to_f; pk = section["peak"].to_f; ev = section["end"].to_f.nonzero? || sv
         up = []; v = sv; while v <= pk + 0.001; up << v; v += step; end
         dn = []; v = pk - step; while v >= ev - 0.001; dn << v; v -= step; end
         vals = up + dn
       end
       vals = vals.map { |v| v == v.to_i ? v.to_i : v }
       seq = vals.size <= 10 ? vals.join(" · ") : "#{vals.first(3).join(" · ")} · … · #{vals.last}"
       ladder_seq_str = "#{seq} #{varies_lbl}".strip
     end
   elsif sec_format == "switchback"
     sb_start = section["start"].to_i.nonzero? || 40
     sb_end   = section["end"].to_i.nonzero?   || 10
     sb_step  = section["step"].to_i.nonzero?  || 10
     down_vals = []
     v = sb_start; while v >= sb_end; down_vals << v; v -= sb_step; end
     up_vals = down_vals.reverse
     switchback_down_str = down_vals.join(" · ")
     switchback_up_str   = up_vals.join(" · ")
   end %>

<%# fmt_label = bold green modality name, fmt_detail = gray italic description, fmt_interval = bold green suffix (tabata only) %>
<% fmt_label, fmt_detail, fmt_interval = case sec_format
   when "rounds"
     r = section["rounds"].to_i
     label  = r > 1 ? "#{r} rounds" : nil
     detail = section["rest_secs"].to_i > 0 && r > 1 ? "#{format_rest_secs(section["rest_secs"])} rest after each round" : nil
     [label, detail]
   when "amrap"
     ["AMRAP", section["duration_mins"] ? "#{section["duration_mins"]} min" : nil]
   when "emom"
     n           = Array(section["exercises"]).size
     dur         = section["duration_mins"].to_i
     period      = section["period_mins"].to_i.nonzero? || 1
     alternating = section["alternating"]
     label       = period == 1 ? "EMOM" : "E#{period}MOM"

     detail_parts = []
     detail_parts << "#{dur} min" if dur > 0

     if n == 2 && alternating && period == 1
       detail_parts << "alternating each minute"
     elsif n >= 2 && alternating
       cycle = n * period
       per_label = period == 1 ? "one exercise per minute" : "one exercise per #{period} minutes"
       detail_parts << "#{cycle}-min rotation, #{per_label}"
     elsif n == 2
       detail_parts << (period == 1 ? "both exercises each minute" : "both exercises every #{period} minutes")
     elsif n > 2
       detail_parts << (period == 1 ? "all #{n} exercises each minute" : "all #{n} exercises every #{period} minutes")
     end

     [label, detail_parts.join(" · ").presence]
   when "continuous_circuit"
     detail_parts = []
     detail_parts << "#{section["duration_mins"]} min" if section["duration_mins"]
     n = Array(section["exercises"]).size
     dur = section["duration_mins"].to_i
     rounds_each = n > 0 && dur > 0 && (dur % n).zero? ? dur / n : nil
     detail_parts << (rounds_each ? "#{n} exercises · #{rounds_each} rounds each — fill each minute" : "#{n} exercises · fill each minute")
     ["Continuous Circuit", detail_parts.join(" · ").presence]
   when "tabata"
     n = Array(section["exercises"]).size
     r = section["rounds"].to_i > 0 ? section["rounds"].to_i : 8
     rotation = if n > 1 && (r % n).zero?
       per = r / n
       if per == 1
         "1 round each"
       elsif n == 2
         "alternating · #{per} rounds each"
       else
         "rotating · #{per} rounds each"
       end
     else
       "#{r} rounds"
     end
     ["Tabata", rotation]
   when "for_time"
     ft_rounds = section["rounds"].to_i
     ft_rounds = [ft_rounds, 1].max
     detail_parts = []
     detail_parts << "#{ft_rounds} round#{"s" if ft_rounds > 1}" if ft_rounds > 1
     detail_parts << "#{format_rest_secs(section["rest_secs"])} rest after each round" if section["rest_secs"].to_i > 0
     ["For Time", detail_parts.join(" · ").presence]
   when "hundred"
     hundred_ex = Array(section["exercises"]).first
     hundred_label = hundred_ex&.dig("calories").to_i > 0 ? "100 Cal" : "100 Reps"
     [hundred_label, "For Time"]
   when "ladder", "mountain"
     parts = [ ladder_seq_str ]
     parts << "#{format_rest_secs(section["rest_between_rungs"])} rest between rungs" if section["rest_between_rungs"].to_i > 0
     [sec_format.capitalize, parts.compact.join(" · ").presence]
   when "switchback"
     ["Up & Down Ladder", "Alternate between each exercise"]
   when "matrix"
     rest = section["rest_secs"].to_i > 0 ? "#{format_rest_secs(section["rest_secs"])} rest between rounds" : nil
     ["Matrix", rest]
   else
     [nil, nil]
   end %>

<div class="bg-zinc-900/60 rounded-xl overflow-hidden border border-zinc-600/50">

  <%# Header: section name + time circle; format description below name %>
  <div class="px-3 py-2.5 bg-zinc-700/40">
    <div class="flex items-center justify-between gap-2">
      <span class="font-black text-white text-xs uppercase tracking-widest" style="font-family: 'Jost', sans-serif"><%= clean_llm_text(section["name"]) %></span>
      <% if local_assigns[:distance_sport] && defined?(sec_dist_val) && sec_dist_val %>
        <div class="flex flex-col items-center justify-center w-8 h-8 rounded-full bg-sky-500 shadow-sm shadow-sky-500/30 flex-shrink-0">
          <span class="text-white font-black text-[9px] leading-none"><%= sec_dist_val %></span>
          <span class="text-sky-200 text-[7px] leading-none mt-0.5"><%= sec_dist_unit %></span>
        </div>
      <% end %>
    </div>
    <% if fmt_label.present? %>
      <p class="text-xs mt-1 leading-relaxed">
        <span class="text-lime-400 font-bold"><%= fmt_label %></span>
        <% if fmt_detail.present? %><span class="text-gray-400 italic"> · <%= fmt_detail %></span><% end %>
        <% if fmt_interval.present? %><span class="text-gray-400 italic"> · <%= fmt_interval %></span><% end %>
      </p>
    <% end %>
  </div>

  <%# Exercises %>
  <% if sec_format == "matrix" %>
    <% exercises = Array(section["exercises"]) %>
    <% n = exercises.size %>
    <% rounds = (1..n).to_a + (n - 1).downto(1).to_a %>
    <% rounds.each_with_index do |count, ri| %>
      <% offset = ri < n ? 0 : ri - n + 1 %>
      <% combo = exercises[offset, count] %>
      <div class="px-3 py-2 border-t border-zinc-700/50">
        <p class="text-white text-sm font-semibold"><%= combo.map { |e|
          metric = if e["duration_s"].to_i > 0
            "#{e["duration_s"].to_i}s "
          elsif e["reps"].to_i > 0
            unit = e["name"].to_s.match?(/carry|sled|prowler|drag|shuttle|farmer/i) ? "m" : ""
            "#{e["reps"]}#{unit} "
          end
          "#{metric}#{e["name"]}"
        }.join(" + ") %></p>
      </div>
    <% end %>
  <% else %>
    <% Array(section["exercises"]).each_with_index do |exercise, ei| %>
      <%= render "shared/exercise_row",
            exercise:       exercise,
            section:        section,
            workout:        workout,
            section_index:  section_index,
            exercise_index: ei,
            swappable:      swappable,
            is_tabata:      sec_format == "tabata",
            preview_token:  preview_token %>
    <% end %>
  <% end %>

  <%# Footer: section notes only %>
  <% if section["notes"].present? %>
    <div class="px-3 py-2 border-t border-zinc-600/40 bg-zinc-700/20">
      <p class="text-gray-400 text-xs leading-relaxed"><%= section["notes"] %></p>
    </div>
  <% end %>

</div>
