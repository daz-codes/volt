<%# Locals: exercise (Hash), section (Hash), workout (Workout, optional),
#           section_index (Integer, optional), exercise_index (Integer, optional),
#           swappable (Boolean, optional), is_tabata (Boolean, optional),
#           preview_token (String, optional) %>
<% is_tabata     = local_assigns.fetch(:is_tabata, section["format"] == "tabata") %>
<% swappable     = local_assigns.fetch(:swappable, false) %>
<% preview_token = local_assigns.fetch(:preview_token, nil) %>
<% persisted_workout = workout&.persisted? ? workout : nil %>
<% dom_id = if swappable && preview_token
               "preview_exercise_#{preview_token}_#{section_index}_#{exercise_index}"
             elsif swappable && persisted_workout
               "exercise_#{persisted_workout.id}_#{section_index}_#{exercise_index}"
             end %>
<% swap_can_show = swappable && (persisted_workout || preview_token) %>

<div <% if dom_id %>id="<%= dom_id %>"<% end %> class="px-3 py-2.5 border-t border-zinc-700/50"
     <% if swap_can_show %>data-controller="swap-exercise"<% end %>>
  <div class="flex items-start justify-between gap-2">
    <div>
      <% video_url = ExerciseVideo.url_for(exercise["name"]) %>
      <p class="text-white font-semibold text-sm" <% if swap_can_show %>data-swap-exercise-target="name"<% end %>>
        <% if video_url %>
          <%= link_to exercise["name"], video_url, target: "_blank", rel: "noopener", class: "underline decoration-dotted underline-offset-2 hover:text-lime-400 transition-colors", onclick: "event.stopPropagation()" %>
        <% else %>
          <%= exercise["name"] %>
        <% end %>
      </p>
      <% if is_tabata %>
        <p class="text-gray-400 text-xs italic mt-0.5">20s hard effort / 10s easy</p>
      <% end %>
    </div>
    <% if swap_can_show %>
      <% swap_path = preview_token ?
           swap_preview_exercise_path(token: preview_token) :
           swap_exercise_workout_path(persisted_workout) %>
      <%= button_to swap_path,
            params: { section_index: section_index, exercise_index: exercise_index },
            method: :post,
            form: { class: "flex-shrink-0", data: { action: "submit->swap-exercise#swap" } },
            class: "text-gray-600 hover:text-lime-400 transition-colors cursor-pointer p-0.5 rounded",
            title: "Swap for an alternative" do %>
        <svg data-swap-exercise-target="icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="1 4 1 10 7 10"/>
          <polyline points="23 20 23 14 17 14"/>
          <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
        </svg>
      <% end %>
    <% end %>
  </div>

  <% is_ladder = %w[ladder mountain].include?(section["format"].to_s) %>
  <% has_metric = !is_ladder && (exercise["distance_m"] || exercise["duration_s"] || exercise["weight_kg"] ||
                  (!is_tabata && (exercise["calories"] || exercise["reps"]))) %>
  <% if has_metric || (!is_ladder && exercise["notes"].present?) %>
    <div class="flex items-center gap-1.5 mt-1 flex-wrap" <% if swap_can_show %>data-swap-exercise-target="details"<% end %>>
      <% if exercise["distance_m"] %>
        <span class="text-xs font-bold text-sky-200"><%= exercise["distance_m"] %>m</span>
      <% elsif !is_tabata && exercise["calories"] %>
        <span class="text-xs font-bold text-sky-200"><%= exercise["calories"] %> cal</span>
      <% elsif !is_tabata && exercise["reps"] %>
        <% reps_unit = exercise["name"].to_s.match?(/carry|sled|prowler|drag|shuttle|farmer/i) ? "m" : "reps" %>
        <span class="text-xs font-bold text-sky-200"><%= exercise["reps"] %> <%= reps_unit %></span>
      <% elsif exercise["duration_s"] %>
        <% ds = exercise["duration_s"].to_i; dm = ds / 60; dr = ds % 60 %>
        <span class="text-xs font-bold text-sky-200"><%= dm > 0 ? "#{dm}min #{dr > 0 ? "#{dr}s" : ""}".strip : "#{ds}s" %></span>
      <% end %>
      <% if exercise["weight_kg"].to_f > 0 %>
        <span class="text-xs font-bold text-sky-200"><%= exercise["weight_kg"] %>kg</span>
      <% end %>
      <% if exercise["notes"].present? %>
        <% breath_match = exercise["notes"].match(/\A(\d+\s+deep breaths(?:\s+each side)?)\b\.?\s*/i)
           if breath_match
             breath_text = breath_match[1]
             remaining_notes = exercise["notes"].sub(/\A\d+\s+deep breaths(?:\s+each side)?\b\.?\s*/i, "").strip
        %>
          <span class="text-xs font-bold text-sky-200"><%= breath_text %></span>
          <% if remaining_notes.present? %>
            <span class="text-gray-400 text-xs italic"><%= remaining_notes %></span>
          <% end %>
        <% else %>
          <span class="text-gray-400 text-xs italic"><%= exercise["notes"] %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
