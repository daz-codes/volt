<%# Locals: workout %>
<dialog id="export_dialog_<%= workout.id %>"
        class="w-full max-w-sm rounded-2xl border border-zinc-600 bg-zinc-800 text-white p-0 shadow-2xl backdrop:bg-black/70"
        onclick="if(event.target===this) this.close()">
  <div class="px-6 py-6">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-black tracking-tight" style="font-family: 'Jost', sans-serif">Export</h2>
      <button type="button" onclick="this.closest('dialog').close()"
              class="flex items-center justify-center w-8 h-8 rounded-full text-gray-500 hover:text-white hover:bg-zinc-700 transition-colors outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="space-y-3">
      <%# Image export option %>
      <% if Current.user.pro_features? %>
        <%= link_to export_image_workout_path(workout),
              data: { turbo: false },
              class: "flex items-center gap-4 w-full p-4 rounded-xl border border-zinc-600 hover:border-lime-400 text-white hover:text-lime-400 transition-colors group" do %>
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-zinc-700 group-hover:bg-zinc-600 flex items-center justify-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-bold text-sm">Image</p>
            <p class="text-xs text-gray-500">1080 &times; 1350 PNG</p>
          </div>
        <% end %>
      <% else %>
        <%= link_to upgrade_subscription_path,
              class: "flex items-center gap-4 w-full p-4 rounded-xl border border-zinc-700 text-gray-500 hover:border-zinc-600 hover:text-gray-400 transition-colors group" do %>
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-zinc-700 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-bold text-sm">Image</p>
            <p class="text-xs text-gray-600">Pro feature</p>
          </div>
        <% end %>
      <% end %>

      <%# PDF export option %>
      <% if Current.user.pro_features? %>
        <%= link_to export_pdf_workout_path(workout),
              data: { turbo: false },
              class: "flex items-center gap-4 w-full p-4 rounded-xl border border-zinc-600 hover:border-lime-400 text-white hover:text-lime-400 transition-colors group" do %>
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-zinc-700 group-hover:bg-zinc-600 flex items-center justify-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-bold text-sm">PDF</p>
            <p class="text-xs text-gray-500">Full workout details</p>
          </div>
        <% end %>
      <% else %>
        <%= link_to upgrade_subscription_path,
              class: "flex items-center gap-4 w-full p-4 rounded-xl border border-zinc-700 text-gray-500 hover:border-zinc-600 hover:text-gray-400 transition-colors group" do %>
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-zinc-700 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="font-bold text-sm">PDF</p>
            <p class="text-xs text-gray-600">Pro feature</p>
          </div>
        <% end %>
      <% end %>
    </div>

    <p class="text-center text-gray-600 text-xs mt-5">More export options coming soon</p>
  </div>
</dialog>
