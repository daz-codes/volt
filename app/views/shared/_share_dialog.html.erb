<%# Locals: shareable (Workout|Program), shareable_type ("Workout"|"Program") %>
<dialog id="share_dialog_<%= shareable_type.downcase %>_<%= shareable.id %>"
        class="w-full max-w-sm rounded-2xl border border-zinc-600 bg-zinc-800 text-white p-0 shadow-2xl backdrop:bg-black/70"
        onclick="if(event.target===this) this.close()">
  <div class="px-6 py-6" data-controller="share-search">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-black tracking-tight" style="font-family: 'Jost', sans-serif">Share</h2>
      <button type="button" onclick="this.closest('dialog').close()"
              class="flex items-center justify-center w-8 h-8 rounded-full text-gray-500 hover:text-white hover:bg-zinc-700 transition-colors outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <p class="text-gray-400 text-sm mb-4 truncate"><%= shareable.name %></p>

    <%= form_with url: shares_path, method: :post, class: "space-y-4" do |f| %>
      <%= f.hidden_field :shareable_type, value: shareable_type %>
      <%= f.hidden_field :shareable_id, value: shareable.id %>
      <input type="hidden" name="recipient_id" value="" data-share-search-target="recipientId">

      <div class="relative">
        <label class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1.5 block">Send to</label>
        <input type="text"
               placeholder="Search by name or username..."
               autocomplete="off"
               data-share-search-target="input"
               data-action="input->share-search#search"
               class="w-full bg-zinc-700 border border-zinc-600 focus:border-lime-400 focus:outline-none rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-500 transition-colors">
        <div data-share-search-target="results" class="absolute z-10 left-0 right-0 mt-1 bg-zinc-800 border border-zinc-600 rounded-xl overflow-hidden max-h-48 overflow-y-auto empty:hidden"></div>
      </div>

      <div>
        <label class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1.5 block">Message <span class="font-normal text-gray-600">(optional)</span></label>
        <textarea name="message" rows="2" placeholder="Add a note..."
                  class="w-full bg-zinc-700 border border-zinc-600 focus:border-lime-400 focus:outline-none rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-500 resize-none transition-colors"></textarea>
      </div>

      <%= f.submit "Share",
          class: "w-full bg-volt hover:bg-volt/80 active:opacity-90 text-zinc-950 font-black py-3 rounded-xl text-sm transition-colors cursor-pointer uppercase tracking-wide" %>
    <% end %>

    <div id="share_dialog_status"></div>
  </div>
</dialog>
