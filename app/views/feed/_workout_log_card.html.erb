<% structure  = workout_log.workout.structure %>
<% workout    = workout_log.workout %>
<% liked      = liked_workout_ids.include?(workout.id) %>
<% like_count = workout.workout_likes.size %>
<% is_own     = workout_log.user == Current.user %>
<% in_library = local_assigns[:library_workout_ids] ? library_workout_ids.include?(workout.id) : is_own %>

<% sections = structure.is_a?(Hash) ? Array(structure["sections"]) : [] %>
<% goal = structure.is_a?(Hash) ? structure["goal"] : nil %>

<div class="bg-zinc-800 sm:border sm:border-zinc-600/70 sm:rounded-2xl overflow-hidden shadow-sm hover:border-gray-600 hover:shadow-md transition-all duration-200">

  <%# ── Card body ── %>
  <div class="px-4 pt-4 pb-3">

    <%# Row 1: Avatar · username · date · location %>
    <div class="flex items-center gap-1.5 mb-3 flex-wrap">
      <%= render "shared/avatar", user: workout_log.user %>
      <%= link_to workout_log.user.display, user_path(workout_log.user),
            data: { turbo_frame: "_top" },
            class: "text-xs font-bold text-gray-300 hover:text-sky-200 transition-colors" %>
      <span class="text-gray-700 text-xs">·</span>
      <span class="text-xs text-gray-600 flex-shrink-0"><%= workout_log.completed_at.strftime("%-d %b %Y") %></span>
      <% if workout_log.location.present? %>
        <span class="text-gray-700 text-xs">·</span>
        <span class="text-xs text-gray-600 truncate"><%= workout_log.location %></span>
      <% end %>
    </div>

    <%# Row 2: Title %>
    <p class="text-gray-300 text-2xl leading-tight tracking-tight font-jost uppercase">
      <%= workout.name.presence || "Untitled Workout" %>
    </p>

    <%# Row 3: Activity type, duration, sweat rating %>
    <div class="flex items-center gap-2 mt-2 flex-wrap">
      <% if workout.activity.present? %>
        <span class="text-volt font-black text-xs uppercase tracking-wide"><%= workout.activity.name %></span>
      <% end %>
      <span class="text-xs font-bold text-gray-300"><%= workout.duration_mins %> min</span>
      <div class="flex gap-px flex-shrink-0">
        <% 5.times do |i| %>
          <span class="text-xs <%= i < workout_log.sweat_rating ? 'opacity-90' : 'opacity-15' %>">💧</span>
        <% end %>
      </div>
    </div>

  </div>

  <%# Photo %>
  <% if workout_log.photo.attached? %>
    <%= image_tag workout_log.photo, class: "w-full max-h-96 object-cover" %>
  <% end %>

  <% if workout_log.notes.present? %>
    <div class="px-4 pt-3 pb-3">
      <p class="text-gray-500 text-sm italic leading-snug"><%= workout_log.notes %></p>
    </div>
  <% end %>

  <%# ── Footer: like+comment left, save+share+pdf right ── %>
  <div class="bg-zinc-900 border-t border-zinc-700 px-3 py-2">
    <div class="flex items-center justify-between">
      <%# Left: like + comment %>
      <div class="flex items-center gap-1">
        <%= turbo_frame_tag "like_workout_#{workout.id}" do %>
          <%= button_to like_workout_path(workout), method: :post,
                form: { class: "contents" },
                class: "flex items-center gap-1.5 p-2 transition-colors cursor-pointer #{liked ? 'text-red-500 hover:text-red-400' : 'text-gray-500 hover:text-gray-300'}",
                title: "Like" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="<%= liked ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span class="text-sm font-semibold"><%= like_count %></span>
          <% end %>
        <% end %>
        <%= link_to workout_log_comments_path(workout_log),
              data: { turbo_frame: dom_id(workout_log, :comments) },
              class: "flex items-center gap-1.5 text-gray-500 hover:text-gray-300 transition-colors p-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="text-sm font-semibold" id="comment_count_<%= workout_log.id %>"><%= workout_log.comments_count %></span>
        <% end %>
      </div>
      <%# Right: repost + save + share + pdf %>
      <div class="flex items-center gap-1">
        <% if is_own %>
          <button type="button"
                  onclick="event.stopPropagation(); document.getElementById('edit_workout_log_<%= workout_log.id %>').showModal()"
                  class="text-gray-500 hover:text-gray-300 transition-colors p-2 cursor-pointer"
                  title="Edit post">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </button>
          <%= button_to workout_log_path(workout_log), method: :delete,
                form: { data: { turbo_confirm: "Delete this post?" }, class: "contents" },
                class: "text-gray-500 hover:text-red-500 transition-colors p-2 cursor-pointer",
                title: "Delete post" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          <% end %>
        <% else %>
          <button type="button"
                  onclick="event.stopPropagation(); document.getElementById('complete_workout_<%= workout.id %>').showModal()"
                  class="text-gray-500 hover:text-lime-400 transition-colors p-2 cursor-pointer"
                  title="Post this workout">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/>
              <polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
            </svg>
          </button>
        <% end %>
        <% unless in_library %>
          <%= button_to save_workout_path(workout), method: :post,
                form: { class: "contents" },
                class: "text-gray-500 hover:text-gray-300 transition-colors p-2 cursor-pointer",
                title: "Save to My Workouts" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          <% end %>
        <% end %>
        <button type="button"
                onclick="event.stopPropagation(); document.getElementById('share_dialog_workout_<%= workout.id %>').showModal()"
                class="text-gray-500 hover:text-gray-300 transition-colors p-2 cursor-pointer"
                title="Share">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/>
          </svg>
        </button>
        <button type="button"
                onclick="event.stopPropagation(); document.getElementById('export_dialog_<%= workout.id %>').showModal()"
                class="text-gray-500 hover:text-gray-300 transition-colors p-2 cursor-pointer"
                title="Export">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </button>
        <%= render "shared/export_dialog", workout: workout %>
      </div>
    </div>
    <% if like_count > 0 %>
      <span id="liked_by_<%= workout.id %>">
        <%= link_to likers_workout_path(workout), class: "text-gray-500 text-xs hover:text-gray-300 transition-colors px-3 pb-1" do %>
          Liked by <%= pluralize(like_count, "person") %>
        <% end %>
      </span>
    <% else %>
      <span id="liked_by_<%= workout.id %>"></span>
    <% end %>
  </div>

  <%# ── Show/Hide Workout toggle ── %>
  <details data-controller="details-toggle">
    <summary class="bg-zinc-900 border-t border-zinc-700/50 px-4 py-2.5 list-none cursor-pointer select-none text-center">
      <span data-details-toggle-target="showLabel" class="inline-flex items-center gap-1.5 text-gray-500 text-xs font-bold uppercase tracking-wide hover:text-gray-300 transition-colors">
        Show Workout
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </span>
      <span data-details-toggle-target="hideLabel" style="display:none" class="items-center gap-1.5 text-gray-400 text-xs font-bold uppercase tracking-wide hover:text-gray-300 transition-colors">
        Hide Workout
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
      </span>
    </summary>
    <div class="bg-zinc-900 border-t border-zinc-700/40 px-3 py-3 space-y-2">
      <% if goal.present? %>
        <p class="text-gray-500 text-sm italic leading-snug mb-2"><%= goal %></p>
      <% end %>
      <% if sections.any? %>
        <% sections.each do |section| %>
          <%= render "shared/workout_section", section: section, distance_sport: false %>
        <% end %>
      <% else %>
        <p class="text-gray-600 text-sm text-center py-4">No workout details added yet</p>
      <% end %>
    </div>
  </details>

  <%= turbo_frame_tag dom_id(workout_log, :comments) %>

</div>

<% if is_own %>
  <%= render "shared/edit_workout_log_dialog", workout_log: workout_log %>
<% else %>
  <%= render "shared/complete_workout_dialog", workout: workout %>
<% end %>
<%= render "shared/share_dialog", shareable: workout, shareable_type: "Workout" %>
