<div class="px-6 py-6">
  <div class="flex items-start justify-between mb-5">
    <h2 class="text-lg font-bold tracking-tight">New Workout</h2>
    <button type="button"
            data-action="click->dialog#close"
            class="flex-shrink-0 ml-2 flex items-center justify-center w-8 h-8 rounded-full text-gray-500 hover:text-white hover:bg-zinc-700 transition-colors focus:outline-none"
            aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="flex flex-col gap-2.5">
    <%# Generate — AI-powered workout %>
    <button type="button" data-action="click->dialog#openGenerate"
            class="flex items-center gap-4 w-full text-left border border-zinc-700 hover:border-lime-400/50 rounded-xl px-4 py-3.5 transition-colors group cursor-pointer">
      <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-lime-400/10 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-lime-400">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
      </div>
      <div>
        <p class="font-bold text-sm text-white group-hover:text-lime-400 transition-colors">Generate</p>
        <p class="text-xs text-gray-500">AI builds a workout for you</p>
      </div>
    </button>

    <%# Build — manual workout creation %>
    <%= link_to new_workout_path,
        class: "flex items-center gap-4 w-full text-left border border-zinc-700 hover:border-lime-400/50 rounded-xl px-4 py-3.5 transition-colors group cursor-pointer" do %>
      <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-sky-400/10 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-sky-400">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
      </div>
      <div>
        <p class="font-bold text-sm text-white group-hover:text-sky-400 transition-colors">Build</p>
        <p class="text-xs text-gray-500">Create your own from scratch</p>
      </div>
    <% end %>

    <%# Scan — photo to workout %>
    <label for="scan-file-input"
           class="flex items-center gap-4 w-full text-left border border-zinc-700 hover:border-lime-400/50 rounded-xl px-4 py-3.5 transition-colors group cursor-pointer">
      <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-violet-400/10 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-violet-400">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
      </div>
      <div>
        <p class="font-bold text-sm text-white group-hover:text-violet-400 transition-colors">Scan</p>
        <p class="text-xs text-gray-500">Snap or upload a workout photo</p>
      </div>
    </label>
  </div>
</div>
