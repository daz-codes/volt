<% content_for :title, @workout.name.presence || "Workout" %>

<% own_workout = Current.user == @workout.user %>

<div class="max-w-2xl mx-auto">

  <%# Mobile-only: actions first, then like %>
  <div class="sm:hidden mb-4 space-y-3">
    <div class="flex gap-2">
      <button type="button"
              onclick="document.getElementById('complete_workout_<%= @workout.id %>').showModal()"
              class="flex-1 text-center bg-volt hover:bg-volt/80 active:opacity-90 text-zinc-950 font-black py-3 rounded-xl text-sm transition-colors uppercase tracking-wide cursor-pointer">
        Post
      </button>
      <% if own_workout %>
        <%= link_to library_path, class: "flex-1 flex items-center justify-center gap-1.5 py-3 px-4 border border-zinc-600 text-gray-400 font-bold rounded-xl text-sm transition-colors hover:border-gray-500 hover:text-gray-300" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Saved
        <% end %>
      <% else %>
        <%= button_to "Save", save_workout_path(@workout), method: :post,
            data: { turbo_frame: "_top" },
            form: { class: "contents" },
            class: "flex-1 text-center py-3 px-4 border border-zinc-600 hover:border-gray-500 text-gray-300 hover:text-white font-bold rounded-xl text-sm transition-colors cursor-pointer" %>
      <% end %>
      <button type="button"
              onclick="document.getElementById('share_dialog_workout_<%= @workout.id %>').showModal()"
              class="flex-1 flex items-center justify-center gap-1.5 py-3 px-4 border border-zinc-600 hover:border-sky-400 hover:text-sky-400 text-gray-300 font-bold rounded-xl text-sm transition-colors cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/>
        </svg>
        Share
      </button>
      <% if own_workout %>
        <%= link_to "Edit", edit_workout_path(@workout),
            data: { turbo_frame: "workout_preview" },
            class: "flex-1 text-center py-3 px-4 border border-zinc-600 hover:border-lime-400 hover:text-lime-400 text-gray-300 font-bold rounded-xl text-sm transition-colors" %>
      <% end %>
      <%= button_to clone_workout_path(@workout), method: :post,
          data: { turbo_frame: "_top" },
          form: { class: "flex-1" },
          class: "w-full flex items-center justify-center gap-1.5 py-3 px-4 border border-zinc-600 hover:border-gray-500 text-gray-300 hover:text-white font-bold rounded-xl text-sm transition-colors cursor-pointer" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        Duplicate
      <% end %>
    </div>
    <div class="flex items-center justify-between">
      <%= link_to root_path, class: "text-gray-500 hover:text-gray-300 text-sm" do %>&larr; Feed<% end %>
    </div>
  </div>

  <%# Desktop: back %>
  <div class="hidden sm:flex mb-6 items-center justify-between">
    <%= link_to root_path, class: "text-gray-500 hover:text-gray-300 text-sm" do %>&larr; Feed<% end %>
  </div>

  <%= turbo_frame_tag "workout_preview" do %>
    <% default_level = Current.user.default_difficulty_level %>
    <%# Clamp initial render to deterministic levels (2-4) to avoid LLM call on page load %>
    <% initial_level = default_level.clamp(2, 4) %>
    <% if initial_level != 3 %>
      <%= render "workouts/preview", workout: @workout, debug_info: @debug_info,
            scaled_structure: @workout.scale_to(initial_level),
            difficulty_level: initial_level %>
    <% else %>
      <%= render "workouts/preview", workout: @workout, debug_info: @debug_info,
            difficulty_level: 3 %>
    <% end %>
  <% end %>

</div>

<%= render "shared/share_dialog", shareable: @workout, shareable_type: "Workout" %>

<% if params[:do_this] %>
  <script>document.getElementById('complete_workout_<%= @workout.id %>')?.showModal()</script>
<% end %>
