<%# Compact workout summary for feed cards. Mirrors the share-image style:
    section label (lime, small caps), short format description, and a one-line
    summary of each exercise (e.g. "20 KB SWINGS"). Warm-ups and cool-downs
    are skipped — workout.export_sections already filters to main + finisher.
    Locals: workout %>
<% sections = workout.export_sections %>

<% if sections.any? %>
  <div class="bg-zinc-900 border-t border-zinc-700/40 px-4 py-4">
    <div class="space-y-4">
      <% sections.each do |section| %>
        <div>
          <% if section[:label].present? %>
            <div class="text-[11px] font-black uppercase text-lime-400 tracking-[0.18em]">
              <%= section[:label] %>
            </div>
          <% end %>
          <% if section[:description].present? %>
            <div class="text-[10px] font-bold uppercase text-gray-500 tracking-wide mt-0.5">
              <%= section[:description] %>
            </div>
          <% end %>
          <% section[:exercises].each do |line| %>
            <div class="text-sm font-bold uppercase text-gray-200 tracking-wide leading-snug mt-1">
              <%= line.upcase %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
<% end %>
