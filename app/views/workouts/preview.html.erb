<% content_for :title, @workout.name.presence || "Workout Preview" %>

<div class="max-w-2xl mx-auto">

  <%# Mobile-only: actions first %>
  <div class="sm:hidden mb-4 space-y-3">
    <div class="flex gap-2">
      <%= button_to persist_preview_workout_path(token: @preview_token, intent: "log"), method: :post,
          data: { turbo_frame: "_top" },
          form: { class: "contents" },
          class: "flex-1 text-center bg-volt hover:bg-volt/80 active:opacity-90 text-zinc-950 font-black py-3 rounded-xl text-sm transition-colors uppercase tracking-wide cursor-pointer" do %>
        Post
      <% end %>
      <%= button_to persist_preview_workout_path(token: @preview_token, intent: "save"), method: :post,
          data: { turbo_frame: "_top" },
          form: { class: "contents" },
          class: "flex-1 flex items-center justify-center gap-1.5 py-3 px-4 border border-lime-400 text-lime-400 hover:bg-lime-400 hover:text-zinc-950 font-bold rounded-xl text-sm transition-colors cursor-pointer" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        Save
      <% end %>
      <%= button_to persist_preview_workout_path(token: @preview_token, intent: "edit"), method: :post,
          data: { turbo_frame: "_top" },
          form: { class: "contents" },
          class: "flex-1 flex items-center justify-center gap-1.5 py-3 px-4 border border-zinc-600 text-gray-400 hover:border-gray-500 hover:text-white font-bold rounded-xl text-sm transition-colors cursor-pointer" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Edit
      <% end %>
    </div>
    <div class="flex items-center justify-between">
      <%= link_to root_path, class: "text-gray-500 hover:text-gray-300 text-sm" do %>&larr; Feed<% end %>
    </div>
  </div>

  <%# Desktop: back %>
  <div class="hidden sm:flex mb-6 items-center justify-between">
    <%= link_to root_path, class: "text-gray-500 hover:text-gray-300 text-sm" do %>&larr; Feed<% end %>
  </div>

  <%= render "workouts/preview_card", workout: @workout, preview_token: @preview_token, debug_info: @debug_info %>

</div>
