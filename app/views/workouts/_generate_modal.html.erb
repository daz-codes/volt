<div class="px-6 py-6 relative">

  <% user_at_limit = Current.user.generation_limit_reached? %>
  <% generations_used = Current.user.pro? ? nil : Current.user.generations_this_week %>

  <div class="flex items-start justify-between mb-6">
    <div>
      <% if user_at_limit %>
        <p class="text-red-400 mt-0.5 text-sm font-medium">You've used all <%= Current.user.generation_limit %> generations this week.</p>
      <% end %>
    </div>
    <button type="button"
            data-action="click->dialog#close"
            class="flex-shrink-0 ml-2 flex items-center justify-center w-8 h-8 rounded-full text-gray-500 hover:text-white hover:bg-zinc-700 transition-colors focus:outline-none"
            aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <%= form_with url: workouts_path, data: { controller: "generate-form", action: "submit->generate-form#showSpinner" } do |f| %>

    <%# Session Type — Volt workout pills with info icons %>
    <% volt_types = [
      { name: "Maximum Voltage",   icon: "muscle",      desc: "The ultimate all-round workout" },
      { name: "Transformer",       icon: "strength",    desc: "Heavy lifts, structured sets" },
      { name: "Alternator",        icon: "alternator",  desc: "Machine cardio + floor strength" },
      { name: "Circuit Breaker",   icon: "circuit",     desc: "Fast, functional circuits with minimal rest" },
      { name: "Dynamo",            icon: "dynamo",      desc: "Bodyweight HIIT — no equipment needed" },
      { name: "Iron Engine",       icon: "kettlebell",  desc: "Kettlebell flows, swings & grinds" },
      { name: "Ohm",               icon: "ohm",         desc: "Yoga, pilates & mobility" },
      { name: "Volt Octathlon",    icon: "octathlon",   desc: "8-station fitness test — thrusters, row, slams, ski, swings, bike, devil press, run" },
      { name: "Turbine",           icon: "turbine",     desc: "Pure cardio — treadmill, bike, rower & ski erg" }
    ] %>
    <%# SVG icon lookup for the info modal %>
    <% icon_svgs = {
      "muscle"     => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h1m16 0h1M6.5 9.5 5 7m13.5 2.5L20 7M9 12a3 3 0 0 1 6 0m-6 0H6.5a2 2 0 0 0 0 4H9m6 0h2.5a2 2 0 0 0 0-4H15m-6 4v2m6-2v2"/></svg>',
      "strength"   => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="3" height="6" rx="1"/><rect x="19" y="9" width="3" height="6" rx="1"/><rect x="5" y="7" width="2" height="10" rx="0.5"/><rect x="17" y="7" width="2" height="10" rx="0.5"/><line x1="7" y1="12" x2="17" y2="12"/></svg>',
      "alternator" => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><polyline points="7 15 3 19 7 23"/><line x1="21" y1="5" x2="9" y2="5"/><line x1="3" y1="19" x2="15" y2="19"/></svg>',
      "circuit"    => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
      "dynamo"     => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48 2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83"/><circle cx="12" cy="12" r="3"/></svg>',
      "treadmill"  => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3a1 1 0 1 0 2 0 1 1 0 0 0-2 0"/><path d="M14 7l-2 9 4-2 3 5"/><path d="M9 9l-3 12"/><path d="M3 21h18"/><path d="M12 7l-4 4 2 1"/></svg>',
      "kettlebell" => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 0-4 4c0 1.1.4 2 1.1 2.7L8 10a6 6 0 1 0 8 0l-1.1-1.3A3.98 3.98 0 0 0 16 6a4 4 0 0 0-4-4z"/><path d="M10 6a2 2 0 1 1 4 0"/></svg>',
      "ohm"        => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2"/><path d="M12 8c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4"/><path d="M12 6v2m0 8v2"/></svg>',
      "octathlon"  => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
      "turbine"    => '<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="2"/><path d="M12 10V2"/><path d="M12 22v-8"/><path d="M10.3 12.7 4.9 18.1"/><path d="M19.1 5.9l-5.4 5.4"/><path d="M13.7 12.7l5.4 5.4"/><path d="M4.9 5.9l5.4 5.4"/></svg>'
    } %>
    <div class="mb-6" data-controller="activity-info">
      <p class="text-sm font-semibold text-gray-300 uppercase tracking-wide mb-3">Workout Type</p>
      <span class="text-gray-600 text-xs block mb-2">Volt Standard Workouts:</span>
      <div class="flex flex-wrap gap-2">
        <% volt_types.each do |vt| %>
          <label class="cursor-pointer inline-flex">
            <%= radio_button_tag "activity", vt[:name], false,
                id: "activity_#{vt[:name].parameterize}",
                class: "peer sr-only",
                data: { generate_form_target: "pill", action: "change->generate-form#pillSelected" } %>
            <div class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full border border-zinc-600 text-xs font-semibold text-gray-400 peer-checked:border-lime-400 peer-checked:bg-lime-400/10 peer-checked:text-lime-400 transition-all">
              <%= vt[:name] %>
              <button type="button"
                      data-action="click->activity-info#show"
                      data-activity-info-name-param="<%= vt[:name] %>"
                      data-activity-info-desc-param="<%= vt[:desc] %>"
                      data-activity-info-icon-param="<%= vt[:icon] %>"
                      class="flex items-center justify-center text-gray-600 hover:text-lime-400 transition-colors focus:outline-none"
                      aria-label="Info about <%= vt[:name] %>"
                      onclick="event.preventDefault()">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
                </svg>
              </button>
            </div>
          </label>
        <% end %>
      </div>

      <%# Info modal overlay — covers the form, must be dismissed %>
      <div data-activity-info-target="overlay"
           class="hidden absolute inset-0 z-50 bg-zinc-900/80 backdrop-blur-sm flex items-center justify-center p-6">
        <div class="bg-zinc-800 border border-zinc-600 rounded-2xl px-6 py-5 max-w-xs w-full text-center shadow-xl">
          <div class="text-lime-400 flex justify-center mb-3" data-activity-info-target="overlayIcon"></div>
          <p class="font-bold text-white text-lg" data-activity-info-target="overlayName"></p>
          <p class="text-gray-400 text-sm mt-2 leading-relaxed" data-activity-info-target="overlayDesc"></p>
          <button type="button"
                  data-action="click->activity-info#close"
                  class="mt-4 px-5 py-2 bg-zinc-700 hover:bg-zinc-600 text-white text-sm font-semibold rounded-xl transition-colors focus:outline-none">
            Got it
          </button>
        </div>
      </div>

      <%# Hidden SVG templates for the modal icon %>
      <% icon_svgs.each do |key, svg| %>
        <template data-activity-info-target="iconTemplate" data-icon="<%= key %>"><%= raw svg %></template>
      <% end %>

      <% core_names = volt_types.map { |vt| vt[:name] }
         recent_activities = Current.user.workouts
                                        .where(status: "active")
                                        .where.not(activity_id: nil)
                                        .joins(:activity)
                                        .where.not(activities: { name: core_names })
                                        .order(created_at: :desc)
                                        .limit(20)
                                        .pluck("activities.name")
                                        .uniq
                                        .first(5) %>
      <% if recent_activities.any? %>
        <span class="text-gray-600 text-xs block mt-3 mb-2">Recent:</span>
        <div class="flex flex-wrap gap-2">
          <% recent_activities.each do |name| %>
            <label class="cursor-pointer">
              <%= radio_button_tag "activity", name, false,
                  id: "activity_#{name.parameterize}",
                  class: "peer sr-only",
                  data: { generate_form_target: "pill", action: "change->generate-form#pillSelected" } %>
              <div class="px-3 py-1.5 rounded-full border border-zinc-600 text-xs font-semibold text-gray-400 peer-checked:border-lime-400 peer-checked:bg-lime-400/10 peer-checked:text-lime-400 transition-all">
                <%= name %>
              </div>
            </label>
          <% end %>
        </div>
      <% end %>

      <div class="mt-3">
        <%= text_field_tag :custom_activity, nil,
            placeholder: "Or enter any other workout type, e.g. Heavy Lifting, Climbing, Zone 2, Hyrox",
            maxlength: 100,
            class: "w-full bg-zinc-800 border border-zinc-700 rounded-xl px-3 py-2 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-lime-400 transition-colors",
            data: { generate_form_target: "customInput", action: "input->generate-form#customTyped" } %>
      </div>
    </div>

    <%# Session Notes — free text %>
    <div class="mb-6">
      <p class="text-sm font-semibold text-gray-300 uppercase tracking-wide mb-1">Training Notes</p>
      <p class="text-xs text-gray-500 mb-3">Intensity, focus, equipment — anything that should shape this session.</p>
      <%= text_area_tag :session_notes, nil,
          placeholder: "e.g. upper body focus, zone 2 only, no running, heavy deadlifts today…",
          rows: 3,
          class: "w-full bg-zinc-800 border border-zinc-600 rounded-xl px-4 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-lime-400 transition-colors resize-none" %>
    </div>

    <%# Equipment — collapsible, pre-filled from profile %>
    <% current_equipment = Current.user.equipment_with_defaults %>
    <% all_selected = (User::EQUIPMENT_SLUGS - current_equipment).empty? %>
    <% equipment_summary = all_selected ? "All available" : "#{current_equipment.size} of #{User::EQUIPMENT_SLUGS.size} selected" %>
    <details class="mb-6 group">
      <summary class="flex items-center justify-between cursor-pointer list-none select-none">
        <div>
          <p class="text-sm font-semibold text-gray-300 uppercase tracking-wide">Equipment</p>
          <p class="text-xs text-gray-500 mt-0.5"><%= equipment_summary %></p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500 group-open:rotate-180 transition-transform">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </summary>
      <div class="mt-3">
        <p class="text-xs text-gray-500 mb-3">Only exercises using the ticked equipment will be suggested. Bodyweight is always allowed.</p>
        <%# Hidden sentinel so unchecking everything still submits an equipment key %>
        <%= hidden_field_tag "equipment[]", "" %>
        <div class="flex flex-wrap gap-x-4 gap-y-1.5">
          <% User::EQUIPMENT_OPTIONS.each do |slug, label| %>
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <%= check_box_tag "equipment[]", slug, current_equipment.include?(slug),
                  id: "generate_equipment_#{slug}",
                  class: "w-3.5 h-3.5 rounded border-zinc-500 bg-zinc-800 text-lime-400 focus:ring-lime-400 focus:ring-offset-0 accent-lime-400" %>
              <span class="text-xs text-gray-300"><%= label %></span>
            </label>
          <% end %>
        </div>
      </div>
    </details>

    <%# Injuries — collapsible, pre-filled from profile %>
    <% profile_injuries = Current.user.injury_notes.to_s.strip %>
    <details class="mb-6 group">
      <summary class="flex items-center justify-between cursor-pointer list-none select-none">
        <div>
          <p class="text-sm font-semibold text-gray-300 uppercase tracking-wide">Injuries</p>
          <p class="text-xs text-gray-500 mt-0.5"><%= profile_injuries.present? ? profile_injuries.truncate(60) : "None set" %></p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500 group-open:rotate-180 transition-transform">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </summary>
      <div class="mt-3">
        <p class="text-xs text-gray-500 mb-2">Exercises that aggravate these will be avoided. Save long-term injuries on your <a href="<%= edit_profile_path %>" class="text-lime-400 hover:text-lime-300">profile</a>.</p>
        <%= text_area_tag :injury_notes, profile_injuries,
            placeholder: "e.g. torn left ACL, shoulder impingement, bad lower back…",
            rows: 2,
            class: "w-full bg-zinc-800 border border-zinc-600 rounded-xl px-4 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-lime-400 transition-colors resize-none" %>
      </div>
    </details>

    <%# Duration %>
    <div class="mb-6">
      <div data-controller="duration-slider">
        <div class="flex items-baseline justify-between mb-2">
          <span class="text-gray-500 text-xs">Duration</span>
          <p class="text-2xl font-bold text-white">
            <span data-duration-slider-target="display">60</span>
            <span class="text-base font-normal text-gray-400">min</span>
          </p>
        </div>
        <%= f.range_field :duration_mins, value: 60, min: 5, max: 120, step: 5,
            class: "w-full h-2 bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-lime-400",
            data: { duration_slider_target: "input", action: "input->duration-slider#update" },
            required: true %>
        <div class="flex justify-between text-xs text-gray-600 mt-1.5">
          <span>5 min</span>
          <span>2 hrs</span>
        </div>
      </div>
    </div>

    <% unless user_at_limit %>
      <button type="submit"
          class="w-full bg-volt hover:bg-volt/80 active:opacity-90 text-zinc-950 font-bold py-3.5 rounded-xl text-lg transition-colors cursor-pointer"
          data-generate-form-target="submitBtn">
        Generate Workout
      </button>
    <% end %>

  <% end %>

  <%# Upgrade CTAs — outside the form so button_to works (no nested forms) %>
  <% if user_at_limit %>
    <div class="bg-zinc-800 border border-zinc-600 rounded-xl p-4 mb-4 text-center">
      <p class="text-white font-bold text-sm mb-1">Weekly limit reached</p>
      <p class="text-gray-400 text-xs mb-3">You've used all your generations this week. Check back next week or activate a beta code on your profile.</p>
      <%= link_to "Go to Profile", profile_path,
          class: "inline-block w-full bg-volt hover:bg-volt/80 text-zinc-950 font-bold py-3 rounded-xl text-base transition-colors text-center cursor-pointer" %>
    </div>
  <% elsif Current.user.free? %>
    <p class="text-gray-600 text-xs text-center mb-3">
      <%= generations_used %> of <%= Current.user.generation_limit %> generations used this week ·
      <%= link_to "Become a Beta Tester", profile_path,
          class: "text-volt hover:text-volt/80 text-xs" %>
    </p>
  <% end %>

</div>
