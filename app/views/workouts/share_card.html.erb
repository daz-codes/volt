<%# Standalone Instagram share card — no layout, self-contained styles %>
<% export_sections = @workout.export_sections %>
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@700;900&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #09090b;
    font-family: 'Jost', system-ui, sans-serif;
    display: flex;
    justify-content: center;
    padding: 24px 0;
  }

  .card {
    width: 390px;
    min-height: 488px;
    background: #18181b;
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 20%, rgba(163,230,53,0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  .header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .type-label {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #71717a;
  }

  .duration {
    font-size: 14px;
    font-weight: 900;
    color: #a1a1aa;
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .workout-name {
    font-size: 36px;
    font-weight: 900;
    text-transform: uppercase;
    color: #fafafa;
    letter-spacing: -0.5px;
    line-height: 1;
    margin-bottom: 20px;
  }

  .divider {
    height: 3px;
    background: linear-gradient(90deg, #a3e635 0%, transparent 100%);
    margin-bottom: 20px;
    border-radius: 2px;
  }

  .sections-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 24px;
  }

  .section-block {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .section-label {
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #a3e635;
  }

  .section-description {
    font-size: 11px;
    font-weight: 700;
    color: #71717a;
    letter-spacing: 0.5px;
  }

  .exercise-line {
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    color: #e4e4e7;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }

  .footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid #27272a;
  }

  .brand {
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #a3e635;
  }
</style>
</head>
<body>
<div class="card">

  <div class="header-row">
    <% if @workout.activity.present? %>
      <span class="type-label"><%= @workout.activity.name %></span>
    <% end %>
    <span class="duration"><%= @workout.duration_mins %> min</span>
  </div>
  <div class="workout-name"><%= @workout.name %></div>

  <div class="divider"></div>

  <div class="sections-list">
    <% export_sections.each do |section| %>
      <div class="section-block">
        <% if section[:label].present? %>
          <div class="section-label"><%= section[:label] %></div>
        <% end %>
        <% if section[:description].present? %>
          <div class="section-description"><%= section[:description] %></div>
        <% end %>
        <% section[:exercises].each do |line| %>
          <div class="exercise-line"><%= line.upcase %></div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="footer">
    <span class="brand">Volt</span>
  </div>

</div>
</body>
</html>
