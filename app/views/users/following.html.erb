<% content_for :title, "#{@profile_user.display} — Following" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to user_path(@profile_user), class: "inline-flex items-center gap-1.5 -ml-1 px-1 py-1.5 text-gray-400 hover:text-white transition-colors text-sm mb-2" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      <span><%= @profile_user.display %></span>
    <% end %>
    <h1 class="text-lg font-black tracking-tight" style="font-family: 'Jost', sans-serif">Following</h1>
  </div>

  <% if @users.any? %>
    <div class="space-y-1">
      <% @users.each do |user| %>
        <div class="flex items-center justify-between bg-zinc-800 sm:border sm:border-zinc-600/70 sm:rounded-xl px-4 py-3">
          <%= link_to user_path(user), class: "flex items-center gap-3 min-w-0 flex-1" do %>
            <%= render "shared/avatar", user: user, classes: "w-10 h-10 text-sm" %>
            <div class="min-w-0">
              <p class="text-white font-bold text-sm truncate"><%= user.display %></p>
              <% if user.username.present? %>
                <p class="text-gray-500 text-xs truncate">@<%= user.username %></p>
              <% end %>
            </div>
          <% end %>
          <% unless user == Current.user %>
            <%= render "shared/follow_button",
                  user: user,
                  follow_state: Current.user.follow_state_for(user),
                  follow: Current.user.follows_as_follower.find_by(following: user) %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-zinc-800 sm:border sm:border-zinc-600/70 sm:rounded-2xl p-12 text-center">
      <p class="text-gray-600 text-sm">Not following anyone yet.</p>
    </div>
  <% end %>
</div>
